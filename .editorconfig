root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,xml,properties,yml,yaml,json,js,ts,vue,css,scss,html,sql,sh,md}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
