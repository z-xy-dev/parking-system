# 本地开发环境变量示例
# 复制本文件为 .env 并填入你自己的实际值。
# .env 已被 .gitignore 忽略，不会提交到仓库。
# 启动各服务前，将这些变量导出到当前终端（参见 README「本地开发环境变量」）。

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Nacos（服务注册中心）=====
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=your_nacos_password
